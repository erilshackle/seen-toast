{
  "name": "seentoast",
  "version": "1.0.0",
  "description": "Modern, lightweight and customizable toast notification library.",
  "type": "module",
  "main": "./dist/seentoast.umd.js",
  "module": "./dist/seentoast.es.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/seentoast.es.js",
      "require": "./dist/seentoast.umd.js"
    },
    "./style.css": "./dist/seentoast.css"
  },
  "files": [
    "dist"
  ],
  "keywords": [
    "toast",
    "notification",
    "typescript",
    "javascript",
    "ui",
    "toast-library",
    "frontend"
  ],
  "homepage": "https://github.com/erilshackle/seen-toast",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/erilshackle/seen-toast.git"
  },
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "build": "tsc -p tsconfig.build.json && vite build",
    "preview": "vite preview"
  },
  "devDependencies": {
    "typescript": "^5.9.2",
    "vite": "^7.1.3"
  }
}
