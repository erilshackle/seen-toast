{
  "compilerOptions": {
    "target": "ES2023",
    "module": "ESNext",
    "lib": ["ES2023", "DOM"],

    "rootDir": "./src",
    "outDir": "./dist",

    "declaration": true,
    "emitDeclarationOnly": true,

    "moduleResolution": "bundler",
    "skipLibCheck": true,

    "strict": true
  },
  "include": ["src"]
}